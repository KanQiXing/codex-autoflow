#!/usr/bin/env bash
# ============================================================================
#  codex-autoflow — 蒸馏自六大开源工作流的 Codex CLI 自治执行引擎
#
#  生命周期: interview(访谈) -> plan(规划) -> approve(审批)
#            -> run(持续执行) -> verify(验证) -> review(复盘)
#
#  零依赖: bash + git + codex。状态即文件，历史即 git。
#  铁律: 一切落盘 · 先审后动 · 单任务循环 · 证据即完成 · 上下文重注入
# ============================================================================
set -uo pipefail

VERSION="1.1.0"
FLOW_DIR=".flow"
EXTRA_ARGS="${FLOW_CODEX_ARGS:-}"
AUTO_REVIEW="${FLOW_AUTO_REVIEW:-1}"
TASK_TIMEOUT="${FLOW_TASK_TIMEOUT:-600}"

# ---------- 定位引擎根目录（macOS bash3 兼容，不依赖 readlink -f） ----------
resolve_root() {
  local p="$0" d
  while [ -L "$p" ]; do
    d="$(cd "$(dirname "$p")" 2>/dev/null && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  ROOT="$(cd "$(dirname "$p")" && pwd)"
  [ -d "$ROOT/skills" ] || ROOT="$PWD"
}
resolve_root

# ---------- 文件锁：防止并发 run 损坏共享状态 ----------
acquire_lock() {
  [ "${FLOW_FORCE:-0}" = "1" ] && return 0
  local lockfile="$FLOW_DIR/.lock"
  [ -d "$FLOW_DIR" ] || die "状态目录不存在: 先运行 flow init"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$lockfile" 2>/dev/null || return 0
    flock -n 9 2>/dev/null || die "另一个 flow 进程正在运行。如确认无冲突，删除 $lockfile 或设置 FLOW_FORCE=1 后重试。"
  else
    if [ -f "$lockfile" ]; then
      local pid
      pid="$(cat "$lockfile" 2>/dev/null || echo 0)"
      if kill -0 "$pid" 2>/dev/null; then
        die "另一个 flow 进程 (PID $pid) 正在运行。如确认无冲突，删除 $lockfile 或设置 FLOW_FORCE=1 后重试。"
      fi
    fi
    echo "$$" > "$lockfile" 2>/dev/null || true
  fi
}

release_lock() {
  local lockfile="$FLOW_DIR/.lock"
  if command -v flock >/dev/null 2>&1; then
    flock -u 9 2>/dev/null || true
  fi
  rm -f "$lockfile" 2>/dev/null || true
}

# ---------- 输出 ----------
info() { printf '\033[1;36m[flow]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ ok ]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[fail]\033[0m %s\n' "$*" >&2; exit 1; }

now() { date '+%Y-%m-%d %H:%M'; }

# ---------- 内容校验与审批绑定 ----------
file_hash() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    return 1
  fi
}

require_hash_tool() {
  file_hash "$FLOW_DIR/PLAN.md" >/dev/null 2>&1 \
    || die "未找到 SHA-256 工具: 请安装 sha256sum 或 shasum 后重试"
}

validate_approval() {
  [ -f "$FLOW_DIR/APPROVED" ] || die "计划未审批: 先运行 flow approve"
  require_hash_tool
  local approved_hash current_hash
  approved_hash="$(awk -F= '$1 == "plan_sha256" {print $2; exit}' "$FLOW_DIR/APPROVED")"
  current_hash="$(file_hash "$FLOW_DIR/PLAN.md")"
  [ -n "$approved_hash" ] || die "审批记录缺少计划校验值: 请重新运行 flow approve"
  [ "$approved_hash" = "$current_hash" ] \
    || die "PLAN.md 已在审批后修改: 请重新运行 flow approve"
}

task_is_completed() {
  local task_id="$1"
  grep -Eq "^[[:space:]]*- \[x\][[:space:]]+$task_id([:[:space:]]|$)" "$FLOW_DIR/PLAN.md"
}

task_has_verification() {
  local task_id="$1"
  [ -s "$FLOW_DIR/VERIFICATIONS/${task_id}.md" ]
}

# ---------- 技能加载: SKILL.md 的 frontmatter 之后的正文即提示词 ----------
# 状态机解析：跟踪代码块（```），代码块内的 --- 不算 frontmatter 结束
skill_body() {
  awk '
    /^---$/ && fm==0 && code==0 { fm=1; next }
    /^---$/ && fm==1 && code==0 { fm=0; next }
    /^```/ { code = (code+1) % 2 }
    fm==0 { print }
  ' "$ROOT/skills/$1/SKILL.md"
}

require_flow() {
  [ -f "$FLOW_DIR/PLAN.md" ] || die "本项目未初始化: 先运行 flow init"
}
require_codex() {
  command -v codex >/dev/null 2>&1 \
    || die "未找到 codex 命令: https://github.com/openai/codex"
}
require_git() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "不在 git 仓库内: 先 git init"
}

# 任务统计（先检查文件存在性；grep -c 无匹配时输出 0 但返回非零，用变量捕获避免重复输出）
_count() {
  local pattern="$1" c
  [ -f "$FLOW_DIR/PLAN.md" ] || { echo 0; return; }
  c="$(grep -cE "$pattern" "$FLOW_DIR/PLAN.md" 2>/dev/null || true)"
  echo "${c:-0}"
}
count_open() { _count '^[[:space:]]*- \[ \]'; }
count_done() { _count '^[[:space:]]*- \[x\]'; }
count_all()  { _count '^[[:space:]]*- \[[ x]\]'; }

# 依赖图执行：返回下一个可执行任务 ID（所有依赖已完成）
# 若有未完成任务但全部被阻塞（循环依赖），输出 BLOCKED
# 若无非完成任务，输出空
next_task_id() {
  [ -f "$FLOW_DIR/PLAN.md" ] || return
  awk '
    /^[[:space:]]*- \[x\]/ {
      match($0, /T[0-9]+/);
      if (RSTART > 0) completed[substr($0, RSTART, RLENGTH)] = 1
      cur = ""
      next
    }
    /^[[:space:]]*- \[ \]/ {
      match($0, /T[0-9]+/);
      if (RSTART > 0) {
        cur = substr($0, RSTART, RLENGTH)
        tasks[++n] = cur
        deps[cur] = "无"
      }
      next
    }
    /依赖:/ {
      if (cur != "") {
        line = $0
        sub(/.*依赖:[[:space:]]*/, "", line)
        gsub(/\r/, "", line)
        deps[cur] = line
      }
    }
    END {
      for (i = 1; i <= n; i++) {
        t = tasks[i]
        d = deps[t]
        if (d == "" || d == "无" || d ~ /^无[[:space:]]*$/) { print t; exit }
        ok = 1
        m = split(d, arr, /[,，、 　]+/)
        for (j = 1; j <= m; j++) {
          dep = arr[j]
          if (dep == "" || dep == "无") continue
          if (!(dep in completed)) { ok = 0; break }
        }
        if (ok) { print t; exit }
      }
      if (n > 0) print "BLOCKED"
    }
  ' "$FLOW_DIR/PLAN.md"
}

# 统一调用: $1=技能名 $2=附加输入(可空) $3=tui 时用交互式 codex（访谈需要对话）
codex_run() {
  require_codex
  local prompt extra
  prompt="$(skill_body "$1")"
  extra="${2:-}"
  if [ -n "$extra" ]; then
    prompt="$prompt

---

## 本轮用户输入
$extra"
  fi
  if [ "${3:-}" = "tui" ]; then
    # 交互式对话模式（无超时，用户在场）
    # shellcheck disable=SC2086
    codex $EXTRA_ARGS "$prompt"
    return $?
  fi
  # 非交互执行模式：加超时保护
  # shellcheck disable=SC2086
  codex exec --skip-git-repo-check $EXTRA_ARGS "$prompt"
  return $?
}

# ---------- 命令: init ----------
cmd_init() {
  require_git
  mkdir -p "$FLOW_DIR/VERIFICATIONS"
  [ -f "$FLOW_DIR/PRD.md" ]      || cp "$ROOT/templates/PRD.md"  "$FLOW_DIR/PRD.md"
  [ -f "$FLOW_DIR/PLAN.md" ]     || cp "$ROOT/templates/PLAN.md" "$FLOW_DIR/PLAN.md"
  [ -f "$FLOW_DIR/PROGRESS.md" ] || printf '# 执行日志（追加式，不要删改历史）\n' > "$FLOW_DIR/PROGRESS.md"
  [ -f "$FLOW_DIR/MEMORY.md" ]   || printf '# 跨会话记忆（教训与约定，保持精简）\n' > "$FLOW_DIR/MEMORY.md"

  # 安全 .gitignore：防止误提交敏感文件与运行日志
  local gi_marker="# codex-autoflow safe ignore"
  if [ -f .gitignore ] && grep -q "$gi_marker" .gitignore 2>/dev/null; then
    info ".gitignore 已包含安全规则，跳过"
  else
    printf '\n%s\n.flow/last-run.log\n.flow/.lock\n*.env\n*.key\n*.pem\n.secrets\n' "$gi_marker" >> .gitignore
    info "已追加安全 .gitignore 规则"
  fi

  local marker="autoflow-codex 状态契约"
  if [ -f AGENTS.md ] && grep -q "$marker" AGENTS.md 2>/dev/null; then
    info "AGENTS.md 已包含状态契约，跳过"
  else
    printf '\n%s\n' "$(cat "$ROOT/templates/AGENTS-snippet.md")" >> AGENTS.md
    ok "已注入状态契约 -> AGENTS.md"
  fi
  ok "状态目录就绪 -> $FLOW_DIR/"
  info "下一步: flow interview \"你的想法\""
}

cmd_interview() {
  require_flow
  [ $# -gt 0 ] || die '用法: flow interview "你的想法"'
  codex_run flow-interview "$*" tui
}

cmd_plan() {
  require_flow
  cmp -s "$FLOW_DIR/PRD.md" "$ROOT/templates/PRD.md" \
    && die "PRD 还是空模板: 先 flow interview 生成需求"
  codex_run flow-plan ""
}

cmd_approve() {
  require_flow
  require_hash_tool
  local plan_hash
  plan_hash="$(file_hash "$FLOW_DIR/PLAN.md")"
  printf 'approved_by=human at=%s\nplan_sha256=%s\n' "$(now)" "$plan_hash" > "$FLOW_DIR/APPROVED"
  git add "$FLOW_DIR" 2>/dev/null
  git commit -q -m "flow: 计划已批准" 2>/dev/null || true
  ok "计划已批准 (.flow/APPROVED)"
  info "开始执行: flow run"
}

cmd_once() {
  require_flow
  validate_approval
  require_codex
  acquire_lock
  trap release_lock EXIT INT TERM
  codex_run flow-execute ""
}

cmd_verify() { require_flow; codex_run flow-verify ""; }
cmd_review() { require_flow; codex_run flow-review ""; }

# ---------- rollback: 回滚指定任务（git revert + 重置 checkbox） ----------
cmd_rollback() {
  require_flow; require_git
  local task_id="${1:-}"
  [ -n "$task_id" ] || die "用法: flow rollback T001"
  case "$task_id" in T[0-9]*) ;; *) die "任务 ID 格式应为 T 加数字，如 T001";; esac

  local commit
  commit="$(git log --oneline --grep="flow($task_id)" 2>/dev/null | head -1 | awk '{print $1}')"
  [ -n "$commit" ] || die "未找到任务 $task_id 的提交"

  acquire_lock
  trap release_lock EXIT INT TERM

  info "回滚 $task_id (提交 $commit)..."
  git revert --no-edit "$commit" 2>/dev/null || die "git revert 失败，请手动处理冲突后运行: flow run"

  # 将 PLAN.md 中该任务的 [x] 改回 [ ]
  if [ -f "$FLOW_DIR/PLAN.md" ]; then
    sed -i "s/- \[x\] $task_id/- [ ] $task_id/" "$FLOW_DIR/PLAN.md" 2>/dev/null \
      || sed -i "" "s/- \[x\] $task_id/- [ ] $task_id/" "$FLOW_DIR/PLAN.md" 2>/dev/null || true
  fi

  printf '%s | ROLLBACK | %s | reverted %s\n' "$(now)" "$task_id" "$commit" >> "$FLOW_DIR/PROGRESS.md"
  ok "已回滚 $task_id，可重新执行: flow run"
}

# ---------- powerup: Codex 深度增强（统一技能入口） ----------
cmd_powerup() {
  local mode="${1:-audit}"
  case "$mode" in
    install)
      # 只装资产：三件套子代理 TOML -> .codex/agents/
      mkdir -p .codex/agents
      local a installed=0
      for a in reviewer implementer researcher; do
        if [ -f ".codex/agents/$a.toml" ]; then
          info "已存在 .codex/agents/$a.toml，跳过（如需覆盖请先删除）"
        else
          cp "$ROOT/skills/flow-powerup/assets/$a.toml" ".codex/agents/$a.toml"
          installed=$((installed + 1))
        fi
      done
      [ "$installed" -gt 0 ] && ok "已安装 $installed 个子代理 -> .codex/agents/（重启会话生效）"
      info "审计与深度调优请运行: flow powerup"
      ;;
    audit|*)
      # 全面试诊（交互式，由统一技能接管）
      codex_run flow-powerup "$*" tui
      ;;
  esac
}

# ---------- hub: 技能生态中心（发现/安装/策展/自进化） ----------
cmd_hub() {
  local action="${1:-browse}"
  case "$action" in
    browse|search|find|audit)
      # 交互式：技能策展与安全审计（由 flow-skills-hub 技能接管）
      codex_run flow-skills-hub "$*" tui
      ;;
    *)
      codex_run flow-skills-hub "$*" tui
      ;;
  esac
}

finish_review() {
  if [ "$AUTO_REVIEW" = "0" ]; then
    info "自动复盘已关闭 (FLOW_AUTO_REVIEW=0)"
    return 0
  fi
  info "触发复盘: flow review"
  codex_run flow-review ""
}

# ---------- Ralph 循环: 外层循环 + 每轮全新会话 + 单任务 + 确定性完成门禁 ----------
run_loop() {
  require_flow; require_git
  validate_approval
  require_codex
  acquire_lock
  trap release_lock EXIT INT TERM
  local max="$1" iter=0 stall=0 before after remaining exit_code next_id

  remaining="$(count_open)"
  if [ "$remaining" -eq 0 ]; then
    ok "PLAN.md 已无未完成任务"
    finish_review
    return 0
  fi

  while :; do
    remaining="$(count_open)"
    if [ "$remaining" -eq 0 ]; then
      ok "全部任务完成（共 $iter 轮迭代）"
      finish_review
      return 0
    fi
    # 依赖图检查：若所有未完成任务都被阻塞，报告循环依赖并停机
    next_id="$(next_task_id)"
    if [ "$next_id" = "BLOCKED" ]; then
      die "存在循环依赖或全部任务被阻塞，请检查 PLAN.md 的依赖关系。剩余 $remaining 个任务无法执行。"
    fi
    iter=$((iter + 1))
    if [ "$iter" -gt "$max" ]; then
      warn "达到最大迭代数 $max，剩余任务 $remaining"
      info "继续: flow run"
      return 1
    fi
    info "迭代 $iter/$max · 剩余任务 $remaining"

    before="$(git rev-parse HEAD 2>/dev/null || echo none)"
    # 单任务超时保护：防止 codex 卡死导致停滞熔断失效
    # shellcheck disable=SC2086
    run_codex_with_timeout "$(skill_body flow-execute)" \
      > "$FLOW_DIR/last-run.log" 2>&1
    exit_code=$?
    if [ "$exit_code" -eq 124 ]; then
      warn "任务超时（${TASK_TIMEOUT}s），强制终止本轮"
    elif [ "$exit_code" -ne 0 ]; then
      warn "本轮 codex 退出码 $exit_code，详见 .flow/last-run.log"
    fi
    tail -n 12 "$FLOW_DIR/last-run.log" 2>/dev/null | sed 's/^/    /'

    after="$(git rev-parse HEAD 2>/dev/null || echo none)"
    if ! task_is_completed "$next_id" || ! task_has_verification "$next_id"; then
      stall=$((stall + 1))
      warn "任务 $next_id 未同时完成勾选和验证留痕（连续停滞 $stall/3）"
      [ "$stall" -ge 3 ] \
        && die "连续 3 轮未完成带证据的任务，停止等待人工介入。日志: .flow/last-run.log"
    elif [ "$before" = "$after" ]; then
      stall=$((stall + 1))
      warn "本轮无新提交（连续停滞 $stall/3）"
      [ "$stall" -ge 3 ] \
        && die "连续 3 轮无进展，停止等待人工介入。日志: .flow/last-run.log"
    else
      stall=0
    fi
  done
}

run_codex_with_timeout() {
  local prompt="$1"
  if command -v timeout >/dev/null 2>&1; then
    timeout "$TASK_TIMEOUT" codex exec --skip-git-repo-check $EXTRA_ARGS "$prompt" </dev/null
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$TASK_TIMEOUT" codex exec --skip-git-repo-check $EXTRA_ARGS "$prompt" </dev/null
  else
    warn "未找到 timeout/gtimeout，当前系统无法强制执行任务超时；将继续运行并依赖停滞熔断"
    codex exec --skip-git-repo-check $EXTRA_ARGS "$prompt" </dev/null
  fi
}

cmd_run() {
  local n="${1:-10}"
  case "$n" in ''|*[!0-9]*) die "迭代数必须是正整数";; esac
  [ "$n" -gt 0 ] || die "迭代数必须大于 0"
  run_loop "$n"
}

cmd_status() {
  require_flow
  local all done_n open_n approved
  all="$(count_all)"; done_n="$(count_done)"; open_n="$(count_open)"
  if [ -f "$FLOW_DIR/APPROVED" ]; then approved="已批准"; else approved="未批准 (flow approve)"; fi
  echo
  info "审批: $approved · 任务: $done_n/$all 完成 · 剩余 $open_n"
  if [ -f "$FLOW_DIR/last-run.log" ]; then
    info "最近一轮输出（末 3 行）:"
    tail -n 3 "$FLOW_DIR/last-run.log" | sed 's/^/    /'
  fi
  info "最近 flow 提交:"
  git log --oneline -5 --grep='flow' 2>/dev/null | sed 's/^/    /' || true
  echo
}

cmd_help() {
  cat <<EOF
codex-autoflow v$VERSION — 访谈 -> 规划 -> 审批 -> 持续执行 -> 验证 -> 复盘

用法: flow <命令> [参数]

生命周期:
  init               初始化 .flow/ 状态目录与 AGENTS.md 契约
  interview "想法"   1.深度访谈澄清需求（交互式）      -> .flow/PRD.md
  plan               2.PRD 转单会话粒度任务清单        -> .flow/PLAN.md
  approve            3.人工批准计划                    -> .flow/APPROVED
  run [N]            4.自治循环（默认10轮，停滞3轮熔断）-> 代码+证据+提交
  verify             重验全部已完成任务，刷新证据
  review             复盘蒸馏                          -> .flow/LESSONS.md
  rollback TXXX      回滚指定任务（git revert + 重置 checkbox）
  status             进度概览
  once               单轮执行（调试提示词时用）

Codex 增强:
  powerup            全面体检+调优（AGENTS.md/config/技能/子代理/MCP）
  powerup install    安装三件套子代理 -> .codex/agents/

技能生态:
  hub                技能发现/安装/策展/安全审计（交互式）

环境变量:
  FLOW_CODEX_ARGS    传给 codex 的额外参数，如 "--model gpt-5.2"
  FLOW_AUTO_REVIEW   0 = 完成后不自动复盘（默认 1）
  FLOW_TASK_TIMEOUT  单任务超时秒数（默认 600）
  FLOW_FORCE         1 = 跳过文件锁（用于故障恢复）

⚠️  安全: 不建议配合 --full-auto 使用 flow run，任务间将无人工审查。
铁律: 一切落盘 · 先审后动 · 单任务循环 · 证据即完成 · 上下文重注入
EOF
}

# ---------- 路由 ----------
case "${1:-help}" in
  init)      shift; cmd_init "$@" ;;
  interview) shift; cmd_interview "$@" ;;
  plan)      shift; cmd_plan "$@" ;;
  approve)   shift; cmd_approve "$@" ;;
  run)       shift; cmd_run "${1:-10}" ;;
  once)      shift; cmd_once "$@" ;;
  verify)    shift; cmd_verify "$@" ;;
  review)    shift; cmd_review "$@" ;;
  rollback)  shift; cmd_rollback "$@" ;;
  powerup)   shift; cmd_powerup "$@" ;;
  hub)       shift; cmd_hub "$@" ;;
  status)    shift; cmd_status "$@" ;;
  version|--version|-v) echo "codex-autoflow $VERSION" ;;
  *)         cmd_help ;;
esac
